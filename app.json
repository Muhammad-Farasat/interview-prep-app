{
  "expo": {
    "name": "InterviewAI",
    "slug": "InterviewAI",
    "scheme": "interviewai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.jpeg",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/interview_spalsh_screen.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.interviewai.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.interviewai.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#1a1a2e"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "expo-av",
        {
          "microphonePermission": "Allow InterviewAI to access your microphone."
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "@clerk/expo"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1de5cdaf-42d7-43d6-a2bc-09331d062957"
      }
    },
    "experiments": {
      "tsconfigPaths": true
    },
    "owner": "misstom"
  }
}